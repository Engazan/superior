# Dokploy Compose variables. Copy to server/.env for local `docker compose config`
# or enter the values in the Dokploy Compose environment editor.
SUPERIOR_RELAY_IMAGE=superior-relay:local
SUPERIOR_RELAY_DOMAIN=relay.example.com
SUPERIOR_RELAY_URL=wss://relay.example.com
SUPERIOR_RELAY_PORT=8080
SUPERIOR_RELAY_CERT_RESOLVER=letsencrypt
