{
  "expo": {
    "name": "Superior IDE",
    "slug": "superior-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "superior-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ios-icon.png",
      "bundleIdentifier": "eu.engazan.superior.mobile",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "en",
          "sk",
          "cs",
          "pl",
          "hu"
        ],
        "ITSAppUsesNonExemptEncryption": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#21135C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "eu.engazan.superior.mobile",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#21135C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "sk",
              "cs",
              "pl",
              "hu"
            ],
            "android": [
              "en",
              "sk",
              "cs",
              "pl",
              "hu"
            ]
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Superior to scan your desktop pairing QR code.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fc4163f2-c88c-4802-9a40-a26f73240c59"
      }
    },
    "owner": "engazan",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fc4163f2-c88c-4802-9a40-a26f73240c59"
    },
    "locales": {
      "en": "./locales/en.json",
      "sk": "./locales/sk.json",
      "cs": "./locales/cs.json",
      "pl": "./locales/pl.json",
      "hu": "./locales/hu.json"
    }
  }
}
