{
  "name": "superior",
  "version": "0.39.2",
  "description": "Minimal desktop core: open a folder and run agent CLIs in an embedded terminal.",
  "main": "out/main/index.js",
  "desktopName": "superior.desktop",
  "author": {
    "name": "Patrik Horváth",
    "email": "Engazan.eu@icloud.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/Engazan/superior",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Engazan/superior.git",
    "directory": "desktop"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "node build/fix-pty-helpers.cjs",
    "predev": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "typecheck:node": "tsc --noEmit --composite false -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit --composite false -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run && node --test build/builder-keychain.test.cjs build/fix-pty-helpers.test.cjs",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src electron.vite.config.mts vitest.config.mts",
    "rebuild": "electron-builder install-app-deps",
    "build": "npm run typecheck && electron-vite build",
    "check:bundle": "node build/verify-bundle-size.cjs",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "start": "electron-vite preview"
  },
  "build": {
    "appId": "com.superior.app",
    "productName": "Superior",
    "asar": true,
    "npmRebuild": false,
    "afterPack": "build/after-pack.cjs",
    "files": [
      "out/**",
      "node_modules/node-pty/**"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Engazan",
        "repo": "superior"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "syncDesktopName": true
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "highlight.js": "^11.12.0",
    "node-pty": "^1.1.0",
    "qrcode.react": "^4.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "electron": "^45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "^11.0.9"
    },
    "@electron/universal": {
      "minimatch": "^11.0.9"
    }
  }
}
